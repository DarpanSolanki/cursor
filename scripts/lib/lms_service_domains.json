{
  "version": 1,
  "description": "LMS-wide (non-money-only) service → mandatory impact cases. Used by impact_tests when trustt-/novopay- repos change outside accounting money domains.",
  "services": {
    "accounting": {
      "repo_hints": ["trustt-platform-accounting", "novopay-platform-accounting"],
      "impact_cases": ["health.accounting", "accounting.read_smoke"],
      "fallback_case": "health.accounting"
    },
    "los": {
      "repo_hints": ["trustt-platform-los", "novopay-mfi-los", "mfi-los"],
      "path_hints": ["/los/", "disbursementsync", "origination"],
      "impact_cases": ["health.los"],
      "fallback_case": "health.los"
    },
    "payments": {
      "repo_hints": ["trustt-platform-payments", "novopay-platform-payments"],
      "path_hints": ["/payments/", "collectionloanrepayment", "bulkcollection"],
      "impact_cases": ["health.payments"],
      "fallback_case": "health.payments"
    },
    "actor": {
      "repo_hints": ["trustt-platform-actor", "novopay-platform-actor"],
      "path_hints": ["/actor/"],
      "impact_cases": ["health.actor", "actor.user_basic"],
      "fallback_case": "health.actor"
    },
    "task": {
      "repo_hints": ["trustt-platform-task", "novopay-platform-task"],
      "path_hints": ["/task/"],
      "impact_cases": ["health.task"],
      "fallback_case": "health.task"
    },
    "notifications": {
      "repo_hints": ["trustt-platform-notifications", "novopay-platform-notifications"],
