    "dms": {
      "repo_hints": ["trustt-platform-dms", "novopay-platform-dms"],
      "path_hints": ["/dms/"],
      "impact_cases": ["health.dms"],
      "fallback_case": "health.dms"
    },
    "api_gateway": {
      "repo_hints": ["trustt-platform-api-gateway", "novopay-platform-api-gateway"],
      "path_hints": ["/api-gateway/", "requestforward"],
      "impact_cases": ["health.api_gateway"],
      "fallback_case": "health.api_gateway"
    },
    "simulators": {
      "repo_hints": ["trustt-platform-simulators", "novopay-platform-simulators"],
      "path_hints": ["/simulators/"],
      "impact_cases": ["health.simulators"],
      "fallback_case": "health.simulators"
    },
    "platform_lib": {
      "repo_hints": ["trustt-platform-lib", "novopay-platform-lib"],
      "path_hints": ["infra-", "util-platform"],
      "impact_cases": ["health.accounting", "health.actor", "workspace.doctor.services"],
      "fallback_case": "workspace.doctor.services",
