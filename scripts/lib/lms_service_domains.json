      "impact_cases": ["health.notifications"],
      "fallback_case": "health.notifications"
    },
    "authorization": {
      "repo_hints": ["trustt-platform-authorization", "novopay-platform-authorization"],
      "path_hints": ["/authorization/"],
      "impact_cases": ["health.authorization"],
      "fallback_case": "health.authorization"
    },
    "approval": {
      "repo_hints": ["trustt-platform-approval", "novopay-platform-approval"],
      "path_hints": ["/approval/"],
      "impact_cases": ["health.approval"],
      "fallback_case": "health.approval"
    },
    "masterdata": {
      "repo_hints": ["trustt-platform-masterdata", "novopay-platform-masterdata"],
      "path_hints": ["/masterdata/", "updatebusinessdate"],
      "impact_cases": ["health.masterdata"],
      "fallback_case": "health.masterdata"
    },
    "batch": {
      "repo_hints": ["trustt-platform-batch", "novopay-platform-batch"],
      "path_hints": ["/batch/", "batchschedule"],
