{
  "version": 1,
  "description": "Acceptance-coverage contract \u2014 fail-closed for enforced domains on money/service ship. Existing domains migrate via backlog_domains until annotated.",
  "required_dimensions_default": [
    "happy_path",
    "dirty_state",
    "replay_idempotency",
    "downstream_ui"
  ],
  "domain_required": {
    "death_foreclosure": [
      "happy_path",
      "boundary_zero",
      "dirty_state",
      "replay_idempotency",
      "downstream_ui",
      "adjacent_sibling"
    ]
  },
  "enforced_domains": [
    "death_foreclosure"
  ],
  "require_db_value_asserts": true,
  "db_assert_enforced_on_money_tier": [
    "disbursement"
  ],
  "domain_money_tables": {
    "death_foreclosure": [
      "loan_account_billing_details",
      "transaction_master",
      "loan_account_payments_details",
      "interest_accrual_details"
    ],
    "disbursement": [
      "loan_account",
      "loan_installment_details",
      "loan_due_details",
      "loan_disbursement_mode_details",
      "loan_disbursement_transaction",
      "transaction_master",
      "client_request_response_log"
    ]
  },
  "domain_money_table_required_columns": {
    "client_request_response_log": [
      "client_reference_number",
      "transaction_type",
      "status",
      "request",
      "response",
      "loan_account_number",
      "partner"
    ],
    "loan_account": [
      "loan_status",
      "disbursement_status",
      "loan_amount",
      "loan_product_id"
    ],
    "loan_installment_details": [
      "installment_amount",
      "schedule_number"
    ],
    "loan_due_details": [
      "component_type",
      "due_amount"
    ],
    "loan_disbursement_mode_details": [
      "mode",
      "account_number"
    ],
    "loan_disbursement_transaction": [
      "amount",
      "client_reference_number",
      "transaction_reference_number"
    ],
    "transaction_master": [
      "client_reference_number",
      "original_amount"
    ]
  },
  "backlog_domains": {
    "disbursement": "partial \u2014 dimensions backlog; value-level db_asserts enforced for full disbursement money tables on money tier (2026-07-20 column-audit upgrade)",
    "repayment": "severity \u2014 severity=high",
    "prepayment": "severity \u2014 severity=medium",
    "foreclosure": "migrate \u2014 severity=high",
    "dpi": "migrate \u2014 severity=high",
    "batch": "migrate \u2014 severity=medium",
    "reversal": "migrate \u2014 severity=medium",
    "restructuring": "migrate \u2014 severity=low"
  }
}
