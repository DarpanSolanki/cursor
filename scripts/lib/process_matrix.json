{
  "version": 2,
  "updated": "2026-08-06",
  "description": "Process selection matrix — speed by selection, never by weakening money gates. Cell: required | conditional(<trigger>) | skip. v2 adds cost_s (learned weights), requires (dependency edges) and terminal_state (goal predicates) so the planner computes a minimal ordered path, not an unordered set.",
  "classes": [
    "question",
    "read-only-rca",
    "non-money-fix",
    "money-fix",
    "batch-dpi",
    "release",
    "docs-kb"
  ],
  "phases": [
    "orient",
    "gate",
    "verify",
    "close"
  ],
  "dedup_phases": {
    "comment": "Phases safe to skip on later turns of the SAME open task — orienting twice tells you nothing new. gate/verify/close always re-evaluate because the diff may have moved since the last turn.",
    "phases": [
      "orient"
    ]
  },
  "ttls_seconds": {
    "kg_fresh": 900,
    "env_smoke": 3600,
    "services": 300,
    "compile": 600,
    "train_banner": 120
  },
  "money_floor": {
    "comment": "These processes stay required on money-fix — ratchet forbids weaken to conditional/skip",
    "processes": [
      "train_banner",
      "kg_watermark_gate",
      "acceptance_coverage",
      "ship_discipline",
      "verify_mode_ratchet",
      "enrichment_tier"
    ]
  },
  "predicates": {
    "kg_fresh": {
      "check": "auto",
      "how": "ttl:kg_fresh",
      "label": "KG fresh for the live branch set"
    },
    "impact_ran": {
      "check": "auto",
      "how": "cmd:python3 scripts/lib/impact_tests.py --check-ran",
      "label": "impact plan ran this session"
    },
    "ship_loop_passed": {
      "check": "auto",
      "how": "file:.cursor/.ship-loop-passed.json",
      "label": "ship-loop passed at the required tier"
    },
    "pending_clear": {
      "check": "auto",
      "how": "pending_ship_satisfied",
      "label": "no unsatisfied pending ship work"
    },
    "evidence_cited": {
      "check": "declared",
      "label": "claims backed by this-turn evidence (file:line / SQL / log)"
    },
    "knowledge_loops": {
      "check": "declared",
      "label": "KG + testing suite + reference docs updated"
    },
    "options_board": {
      "check": "declared",
      "label": "OPTIONS BOARD L0-L3 emitted after analysis"
    }
  },
  "terminal_state": {
    "question": [
      "evidence_cited"
    ],
    "read-only-rca": [
      "evidence_cited",
      "options_board"
    ],
    "non-money-fix": [
      "evidence_cited",
      "impact_ran",
      "ship_loop_passed",
      "knowledge_loops"
    ],
    "money-fix": [
      "evidence_cited",
      "kg_fresh",
      "impact_ran",
      "ship_loop_passed",
      "pending_clear",
      "knowledge_loops"
    ],
    "batch-dpi": [
      "evidence_cited",
      "kg_fresh",
      "impact_ran",
      "ship_loop_passed",
      "knowledge_loops"
    ],
    "release": [
      "evidence_cited",
      "ship_loop_passed",
      "pending_clear",
      "knowledge_loops"
    ],
    "docs-kb": [
      "knowledge_loops"
    ]
  },
