{
  "disbursement.quick": {
    "title": "JLG disburseLoan minimal smoke",
    "service": "accounting",
    "cmd": "bash scripts/bin/disburse-quick.sh",
    "notes": "Flat JLG payload (member_details null); scripts/disburse_loan_sanity.py"
  },
  "disbursement.jlg": {
    "title": "JLG disburseLoan full stage suite",
    "service": "accounting",
    "cmd": "STAGE_SUITE=full bash scripts/bin/disburse-quick.sh",
    "notes": "Full validator + DB checks via disburse_loan_sanity.py"
  },
  "disbursement.indl": {
    "title": "INDL disburseLoan minimal smoke",
    "service": "accounting",
    "cmd": "make -C scripts indl"
  },
  "disbursement.shg": {
    "title": "SHG disburseLoan minimal smoke",
    "service": "accounting",
    "cmd": "bash scripts/bin/disburse-shg-quick.sh",
    "notes": "SHG parent+child (member_details[])"
  },
  "disbursement.full_matrix": {
    "title": "Kafka-entry S1–S7 matrix (JLG/INDL/SHG)",
    "service": "accounting",
    "cmd": "bash scripts/run_disbursement_full_matrix.sh"
  },
  "dpic.full": {
    "title": "DPIC: setup → disburse → DPD → calc → booking → billing",
    "service": "accounting",
    "cmd": "bash scripts/dpic/run_full_happy_path.sh",
    "env": { "JOB_TIME": "1781267400000" }
  },
  "dpic.setup": {
    "title": "DPIC DB setup only (product 6367)",
    "cmd": "bash scripts/dpic/run_setup.sh"
  },
  "dpic.disburse": {
    "title": "DPIC disburseLoan only (MFT product 6367)",
    "cmd": "bash scripts/dpic/run_disburse.sh"
  },
  "dpic.eod": {
    "title": "DPIC EOD batches only (needs LOAN_ACCOUNT_ID)",
    "cmd": "bash scripts/dpic/run_eod.sh",
    "env": { "JOB_TIME": "1781267400000" }
  },
  "api.disburseLoan_dpic": {
    "title": "Raw API: disburseLoan (DPIC payload)",
    "cmd": "python3 scripts/testing/api-fire.py disburseLoan -f scripts/dpic/payload/disburse_mft_6367.json --watch-log"
  },
  "api.dpi_booking": {
    "title": "Raw API: dpiAccrualBooking batch",
    "cmd": "python3 scripts/testing/api-fire.py dpiAccrualBooking --batch --watch-log"
  }
}
