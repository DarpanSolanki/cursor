%% Platform Knowledge Graph — Mermaid (Flow Sync Wave 5)
%% Center: accounting-v2. Render in Mermaid 9+ compatible viewer.
%% Legend: edge suffix (A)=ALIGNED (D)=DRIFT (M)=MISMATCH

flowchart TB
  %% --- Styling ---
  classDef acc fill:#ffcc99,stroke:#cc6600,stroke-width:3px  classDef spof stroke:#cc0000,stroke-width:3px
  classDef kafka fill:#e6e6fa,stroke:#333  classDef money stroke-width:4px

  ACC["accounting-v2<br/>(center)"]
  LOS[LOS]
  PAY[payments]
  ACT[actor]
  MD["masterdata<br/>(SPOF date)"]
  BAT[batch-scheduler]
  GW[api-gateway]
  PLAT["platform-lib"]

  KDISB["Kafka<br/>disburse_loan_api_"]
  KSYNC["Kafka<br/>los_lms_disbursement_sync"]
  KBULK["Kafka<br/>bulk_collection_data_"]

  DBACC[("DB<br/>mfi_accounting")]

  ACC:::acc
  MD:::spof
  BAT:::spof
  GW:::spof

  GW -->|"HTTP (D)"| ACC
  GW -->|"HTTP (D)"| LOS
  GW -->|"HTTP (D)"| PAY
  LOS -->|"HTTP (D)"| ACC
  PAY -->|"HTTP (D)"| ACC
  ACC -->|"HTTP (D)"| ACT
  ACC -->|"HTTP (D)"| MD
  BAT -->|"HTTP START job (D)"| ACC
  PLAT -.->|"EC / templates / Kafka client (D)"| ACC
  PLAT -.-> LOS  PLAT -.-> PAY

  LOS -->|"produce (D)"| KDISB
  KDISB -->|"consume (D)"| ACC
  ACC -->|"produce (M)"| KSYNC
  KSYNC -->|"consume (M)"| LOS

  ACC -->|"produce (D)"| KBULK
  KBULK -->|"consume (D)"| PAY

  ACC --> DBACC

  linkStyle 0 stroke-width:2px
  linkStyle 1 stroke-width:2px
  linkStyle 2 stroke-width:2px
  linkStyle 3 stroke-width:3px
  linkStyle 4 stroke-width:3px
  linkStyle 5 stroke-width:2px
  linkStyle 6 stroke-width:2px
  linkStyle 7 stroke-width:2px
  linkStyle 8 stroke-width:1px
  linkStyle 9 stroke-width:1px
  linkStyle 10 stroke-width:1px
  linkStyle 11 stroke-width:4px
  linkStyle 12 stroke-width:4px
  linkStyle 13 stroke-width:4px
  linkStyle 14 stroke-width:4px
  linkStyle 15 stroke-width:3px
