{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 155,
            "command": "python3 \"$CURSOR_PROJECT_DIR/.cursor/hooks/claude-hook-dispatch.py\" --event sessionStart"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "timeout": 20,
            "command": "python3 \"$CURSOR_PROJECT_DIR/.cursor/hooks/rule-router.py\""
          },
          {
            "type": "command",
            "timeout": 50,
            "command": "python3 \"$CURSOR_PROJECT_DIR/.cursor/hooks/claude-hook-dispatch.py\" --event afterFileEdit"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 350,
            "command": "python3 \"$CURSOR_PROJECT_DIR/.cursor/hooks/claude-hook-dispatch.py\" --event afterShellExecution"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 85,
            "command": "python3 \"$CURSOR_PROJECT_DIR/.cursor/hooks/claude-hook-dispatch.py\" --event beforeShellExecution"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 25,
            "command": "python3 \"$CURSOR_PROJECT_DIR/.cursor/hooks/claude-hook-dispatch.py\" --event stop"
          }
        ]
      }
    ]
  }
}
